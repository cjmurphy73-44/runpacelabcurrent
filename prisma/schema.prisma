generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String            @id @default(uuid())
  email                 String            @unique
  name                  String?
  vdot                  Float?
  maxHeartRate          Int?
  restingHr             Int?
  thresholdPaceSecPerKm Int?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  activities            ActivityHistory[]
  customZones           CustomZone[]
  personalBests         PersonalBest[]
}

model ActivityHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   
  details   Json
  createdAt DateTime @default(now())

  @@index([userId])
}

model CustomZone {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  zoneName   String   
  minPaceSec Int?
  maxPaceSec Int?
  minBpm     Int?
  maxBpm     Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model PersonalBest {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sportType      String   @default("RUN") // "RUN", "CYCLE", "SWIM"
  distanceName   String   // e.g., "800m", "5K", "Marathon", "50K Ride"
  distanceMeters Float   
  timeSeconds    Int      
  formattedTime  String   
  dateAchieved   DateTime 
  isAllTime      Boolean  @default(true)
  segments       Json?    
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([sportType])
}
