{
  "name": "WorkoutSession",
  "type": "object",
  "properties": {
    "athlete_id": {
      "type": "string",
      "description": "References AthleteProfile.id"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date the workout took place"
    },
    "sport": {
      "type": "string",
      "enum": [
        "running",
        "cycling",
        "swimming",
        "strength",
        "triathlon",
        "other"
      ],
      "default": "running"
    },
    "duration_minutes": {
      "type": "number",
      "minimum": 0,
      "description": "Total session duration in minutes"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0,
      "description": "Total session duration in seconds (precise value used by the parser)"
    },
    "distance_km": {
      "type": "number",
      "minimum": 0,
      "description": "Total distance in kilometers"
    },
    "avg_hr": {
      "type": "integer",
      "minimum": 0,
      "description": "Average heart rate"
    },
    "max_hr": {
      "type": "integer",
      "minimum": 0,
      "description": "Max heart rate reached in session"
    },
    "avg_power": {
      "type": "number",
      "minimum": 0,
      "description": "Average power in watts (cycling)"
    },
    "avg_cadence": {
      "type": "number",
      "minimum": 0,
      "description": "Average cadence"
    },
    "source_format": {
      "type": "string",
      "enum": [
        "fit",
        "tcx",
        "csv",
        "webhook"
      ],
      "description": "Format of the dominant asset that produced the reconciled master stream (highest-priority bound asset)"
    },
    "raw_file_url": {
      "type": "string",
      "description": "URL of the originally uploaded raw file (primary/first asset)"
    },
    "session_trimp": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "description": "Banister's HR-based TRIMP computed for this session"
    },
    "session_tss": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "description": "rTSS (Running Training Stress Score) fallback computed from Normalized Graded Pace when heart rate is unavailable"
    },
    "efficiency_factor": {
      "type": "number",
      "minimum": 0,
      "description": "Efficiency Factor: average Normalized Graded Pace (or power) divided by average heart rate"
    },
    "aerobic_decoupling": {
      "type": "number",
      "description": "Aerobic decoupling (Pa:HR) percentage between the first and second half of aerobic runs longer than 45 minutes"
    },
    "zone_seconds": {
      "type": "array",
      "description": "Seconds accumulated in each of the five Heart-Rate-Reserve zones [Z1..Z5]. Computed from second-by-second streams or laps; a single-zone estimate from average HR only when neither exists (see zone_method).",
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "zone_method": {
      "type": "string",
      "enum": [
        "stream",
        "laps",
        "average",
        "none"
      ],
      "description": "Which input produced zone_seconds: 'stream' (second-by-second), 'laps' (lap segments), 'average' (single-zone estimate from average HR) or 'none'."
    },
    "zone_bounds_bpm": {
      "type": "array",
      "description": "Snapshot of the athlete's Karvonen zone floors in bpm at ingest time: [Z1, Z2, Z3, Z4, Z5, max]. Stored so a later change to max/resting HR does not silently rewrite history.",
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "active_calories": {
      "type": "number",
      "minimum": 0,
      "description": "Active kilocalories for the session \u2014 the device-reported value when the provider sent one, otherwise a documented estimate (see calories_source / calories_basis)"
    },
    "calories_source": {
      "type": "string",
      "enum": [
        "device",
        "estimated",
        "manual"
      ],
      "description": "Provenance of active_calories: 'device' (watch-reported, never overwritten by an estimate), 'estimated' (Keytel HR regression with optional heat correction) or 'manual' (athlete entry)"
    },
    "calories_basis": {
      "type": "string",
      "description": "Human-readable explanation of how active_calories was produced, e.g. 'Device-reported active calories' or 'Estimated \u00b7 Keytel heart-rate regression \u00b7 heat adjustment +6% (31\u00b0C, 78% humidity)'"
    },
    "temperature_c": {
      "type": "number",
      "description": "Ambient temperature in \u00b0C reported by the provider for this session, when available"
    },
    "humidity_pct": {
      "type": "number",
      "minimum": 0,
      "description": "Ambient relative humidity in % reported by the provider for this session, when available"
    },
    "streams": {
      "type": "array",
      "description": "Unified master telemetry stream reconciled from all bound WorkoutAssets (priority ladder FIT>TCX>CSV). Only stored for shorter sessions to avoid oversized records.",
      "items": {
        "type": "object",
        "properties": {
          "time": {
            "type": "number",
            "description": "Seconds elapsed from the start of the session"
          },
          "heart_rate": {
            "type": "number"
          },
          "altitude": {
            "type": "number"
          },
          "distance": {
            "type": "number"
          },
          "cadence": {
            "type": "number"
          },
          "speed": {
            "type": "number",
            "description": "Speed in meters/second"
          }
        }
      }
    },
    "laps": {
      "type": "array",
      "description": "Reconciled lap/split segments unified from bound assets (FIT lap message 19 preferred, then TCX <Lap>)",
      "items": {
        "type": "object",
        "properties": {
          "lap_index": {
            "type": "integer",
            "description": "Sequential lap number, 0-based"
          },
          "start_time_offset_s": {
            "type": "number",
            "description": "Seconds from session start to the lap start"
          },
          "duration_s": {
            "type": "number",
            "description": "Lap duration in seconds"
          },
          "distance_km": {
            "type": "number",
            "description": "Lap distance in kilometers"
          },
          "avg_hr": {
            "type": "integer",
            "description": "Average heart rate for the lap"
          },
          "max_hr": {
            "type": "integer",
            "description": "Max heart rate for the lap"
          },
          "avg_speed": {
            "type": "number",
            "description": "Average speed for the lap in meters/second"
          }
        }
      }
    },
    "training_plan_session_id": {
      "type": "string",
      "description": "References TrainingPlanSession.id this workout was prescribed against, if any"
    },
    "post_workout_feedback_id": {
      "type": "string",
      "description": "References WorkoutFeedback.id \u2014 the latest AI post-workout insight generated for this session (relation to the WorkoutFeedback entity)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional freeform description (up to 1000 characters) that makes this record text-searchable for AI-assisted discovery."
    }
  },
  "required": [
    "athlete_id",
    "date",
    "sport"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.athlete_id": "{{user.data.athlete_profile_id}}"
        },
        {
          "data.athlete_id": {
            "$in": "{{user.data.coached_athletes}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}