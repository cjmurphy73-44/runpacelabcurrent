{
  "name": "Subscription",
  "type": "object",
  "description": "Per-user subscription plan used to gate premium features. Provisioned by the stripeWebhook function from Stripe events, or by the redeemAccessCode function for beta testers (asServiceRole bypasses RLS). A missing record means the user is on the free tier.",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "References User.id owning this subscription"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "pro",
        "unlimited",
        "coach_pro",
        "team"
      ],
      "default": "free",
      "description": "Entitlement tier: free (limited), pro (gated features), unlimited (pro + uncapped AI), coach_pro (unlimited + coach roster). 'team' is a legacy value kept for backward compatibility with old records; new flows use 'coach_pro'."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "trialing",
        "past_due",
        "canceled"
      ],
      "default": "active"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer id linked to this user"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription id backing the current plan"
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time",
      "description": "End of the current billing period from Stripe, or the access-code expiry for tester-provisioned plans"
    }
  },
  "required": [
    "user_id",
    "plan",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}