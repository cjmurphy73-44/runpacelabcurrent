{
  "name": "StravaConnection",
  "type": "object",
  "description": "Per-athlete Strava OAuth connection. Holds tokens used by stravaSync to pull historical activities and by workoutWebhook to fetch full activity streams for incoming Strava push events.",
  "properties": {
    "athlete_id": {
      "type": "string",
      "description": "References AthleteProfile.id"
    },
    "strava_athlete_id": {
      "type": "string",
      "description": "Strava athlete id returned with the token; the owner_id in webhook events resolves to this"
    },
    "access_token": {
      "type": "string",
      "description": "Current Strava OAuth access token"
    },
    "refresh_token": {
      "type": "string",
      "description": "Strava OAuth refresh token, used to re-authorize after the access token expires"
    },
    "token_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the current access token expires"
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "error",
        "disconnected",
        "expired"
      ],
      "default": "connected"
    },
    "connected_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last successful historical sync or webhook ingest"
    },
    "last_error": {
      "type": "string",
      "description": "Last error message from a failed sync/token refresh"
    }
  },
  "required": [
    "athlete_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}