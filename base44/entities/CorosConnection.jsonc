{
  "name": "CorosConnection",
  "type": "object",
  "description": "Per-athlete COROS OAuth connection. Holds tokens used by the corosSync backend function to pull historical activities and validate incoming COROS webhooks.",
  "properties": {
    "athlete_id": {
      "type": "string",
      "description": "References AthleteProfile.id"
    },
    "coros_user_id": {
      "type": "string",
      "description": "COROS-side user id returned with the access token, used to resolve webhook payloads to this athlete"
    },
    "access_token": {
      "type": "string",
      "description": "Current COROS OAuth access token"
    },
    "refresh_token": {
      "type": "string",
      "description": "COROS OAuth refresh token, used to re-authorize after the access token expires"
    },
    "token_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the current access token expires"
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "error",
        "disconnected"
      ],
      "default": "connected"
    },
    "connected_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last successful historical sync or webhook ingest"
    },
    "last_error": {
      "type": "string",
      "description": "Last error message from a failed sync/token refresh"
    }
  },
  "required": [
    "athlete_id"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}