{
  "name": "AthleteHealthJournal",
  "type": "object",
  "description": "Optional athlete-private, self-reported period and symptom diary. No automated phase-based training claims; never exposed through coach or AI APIs.",
  "properties": {
    "athlete_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "period_started": {
      "type": "boolean",
      "description": "User-reported start of bleeding, not inferred ovulation"
    },
    "flow": {
      "type": "string",
      "enum": [
        "none",
        "spotting",
        "light",
        "medium",
        "heavy"
      ]
    },
    "symptoms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "cramps",
          "headache",
          "fatigue",
          "bloating",
          "mood_change",
          "breast_tenderness",
          "sleep_disruption",
          "other"
        ]
      }
    },
    "symptom_severity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "energy": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "notes": {
      "type": "string",
      "maxLength": 500
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "athlete_id",
    "date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
