{
  "name": "WorkoutAsset",
  "type": "object",
  "description": "A raw source file bound to a WorkoutSession. Supports native multi-file workout compatibility: an athlete can attach a second format (e.g. the FIT behind a CSV, or a TCX export) so the reconciliation engine unifies their streams and laps into one master record without ever discarding the original file. The session's streams/laps are reconciled from its bound assets using a strict priority ladder (FIT > TCX > CSV > manual).",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "References WorkoutSession.id this asset is bound to"
    },
    "athlete_id": {
      "type": "string",
      "description": "References AthleteProfile.id"
    },
    "file_url": {
      "type": "string",
      "description": "URL of the uploaded raw file"
    },
    "file_name": {
      "type": "string",
      "description": "Original uploaded file name"
    },
    "file_type": {
      "type": "string",
      "enum": [
        "fit",
        "tcx",
        "csv"
      ],
      "description": "Parsed file format"
    },
    "source_priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "description": "Reconciliation priority weight: FIT=4, TCX=3, CSV=2, manual=1 \u2014 higher wins per timestamp/channel"
    },
    "parsing_status": {
      "type": "string",
      "enum": [
        "pending",
        "parsed",
        "failed"
      ],
      "default": "pending",
      "description": "Parse outcome for this asset's file"
    },
    "parse_error": {
      "type": "string",
      "description": "Error message when parsing_status is 'failed'"
    },
    "uploaded_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp this asset was attached to its session"
    }
  },
  "required": [
    "session_id",
    "athlete_id",
    "file_url",
    "file_name",
    "file_type"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.athlete_id": "{{user.data.athlete_profile_id}}"
        },
        {
          "data.athlete_id": {
            "$in": "{{user.data.coached_athletes}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}