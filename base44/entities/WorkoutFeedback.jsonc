{
  "name": "WorkoutFeedback",
  "type": "object",
  "description": "AI-generated post-workout insight record produced by the postWorkoutAIEvaluation service. Mirrors the Prisma WorkoutFeedback model (id, workoutId, feedback, status, createdAt) with added intensity + highlights for dynamic color-coded rendering.",
  "properties": {
    "workout_id": {
      "type": "string",
      "description": "References WorkoutSession.id this feedback belongs to (the Prisma workoutId relation)"
    },
    "athlete_id": {
      "type": "string",
      "description": "References AthleteProfile.id; used to scope feedback to the owning athlete"
    },
    "feedback": {
      "type": "string",
      "description": "AI-generated coaching feedback text for the session"
    },
    "input_recording_sha256": {
      "type": "string",
      "description": "Original recording used in the analysis, where attached by the athlete",
      "pattern": "^[0-9a-f]{64}$",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "failed"
      ],
      "default": "pending",
      "description": "Generation status of the feedback record"
    },
    "intensity": {
      "type": "string",
      "enum": [
        "easy",
        "moderate",
        "hard",
        "very_hard"
      ],
      "description": "Classified dominant session intensity used for dynamic color-coding in the UI"
    },
    "highlights": {
      "type": "array",
      "description": "Key takeaway bullets extracted by the AI coach",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional freeform description (up to 1000 characters) that makes this record text-searchable for AI-assisted discovery."
    }
  },
  "required": [
    "workout_id",
    "feedback"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.athlete_id": "{{user.data.verified_athlete_profile_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.athlete_id": "{{user.data.verified_athlete_profile_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.athlete_id": "{{user.data.verified_athlete_profile_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.athlete_id": "{{user.data.verified_athlete_profile_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
