{
  "name": "ProductFamily",
  "$id": "ProductFamily",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "brandId": {
      "type": "string",
      "format": "uuid",
      "description": "Foreign key to Brand entity"
    },
    "name": {
      "type": "string",
      "description": "e.g., Clifton, Ghost, Adrenaline"
    },
    "categoryTags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "e.g., Neutral, Stability, Carbon-Plated, Trail, Hiking, Gym"
    }
  },
  "required": [
    "id",
    "brandId",
    "name",
    "categoryTags"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
