{
  "name": "DailyMetrics",
  "type": "object",
  "properties": {
    "athlete_id": {
      "type": "string",
      "description": "References AthleteProfile.id"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Calendar date these metrics apply to"
    },
    "total_trimp": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "description": "Aggregate daily training stress (sum of session TRIMP, or rTSS fallback when HR is unavailable)"
    },
    "calculated_ctl": {
      "type": "number",
      "default": 0,
      "description": "Chronic Training Load (Fitness) calculated for end of this day"
    },
    "calculated_atl": {
      "type": "number",
      "default": 0,
      "description": "Acute Training Load (Fatigue) calculated for end of this day"
    },
    "calculated_tsb": {
      "type": "number",
      "default": 0,
      "description": "Training Stress Balance (Form) calculated for end of this day"
    },
    "sleep_score": {
      "type": "integer",
      "description": "Sleep quality score for the preceding night"
    },
    "sleep_duration_hours": {
      "type": "number",
      "description": "Total sleep duration in hours for the preceding night, when provided by a wearable"
    },
    "hrv_score": {
      "type": "integer",
      "description": "Heart Rate Variability score for this day"
    },
    "hrv": {
      "type": "number",
      "description": "Raw Heart Rate Variability reading (ms) for this day, if provided by a wearable"
    },
    "resting_hr": {
      "type": "integer",
      "minimum": 0,
      "description": "Measured resting heart rate for this day, if provided by a wearable"
    },
    "body_battery": {
      "type": "integer",
      "minimum": 0,
      "description": "Garmin Body Battery (0-100) for this day, when provided by Garmin Health"
    },
    "stress_score": {
      "type": "integer",
      "minimum": 0,
      "description": "Garmin stress score (0-100, lower is better) for this day, when provided by Garmin Health"
    },
    "readiness_score": {
      "type": "integer",
      "description": "Holistic TrainPaceLab readiness score (0-100) computed by the readiness engine from ingested recovery signals, rolling baselines, and current TSB (Form). Provider-agnostic and comparable across wearables."
    },
    "provider_readiness_score": {
      "type": "integer",
      "description": "The wearable vendor's native readiness/recovery score (Garmin Training Readiness, COROS Recovery, Oura Readiness, Whoop Recovery, etc.) stored as-is so athletes can compare it against the holistic TrainPaceLab score."
    },
    "provider_readiness_source": {
      "type": "string",
      "enum": [
        "garmin",
        "coros",
        "suunto",
        "apple",
        "polar",
        "samsung",
        "oura",
        "whoop",
        "withings",
        "fitbit",
        "manual"
      ],
      "description": "Which wearable produced the provider_readiness_score"
    },
    "recovery_source": {
      "type": "string",
      "enum": [
        "garmin",
        "coros",
        "suunto",
        "apple",
        "polar",
        "samsung",
        "oura",
        "whoop",
        "withings",
        "fitbit",
        "manual"
      ],
      "description": "Which source last populated the recovery biometric fields (hrv/sleep/resting_hr/etc.), shown as a source badge in the UI"
    },
    "notes": {
      "type": "string",
      "description": "Manual subjective notes from the athlete"
    },
    "holistic_factors": {
      "type": "object",
      "description": "Quick-logged lifestyle/holistic context for this day",
      "properties": {
        "nutrition_status": {
          "type": "string",
          "enum": [
            "under_fueled",
            "fueled"
          ]
        },
        "muscle_soreness": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "travel_jet_lag": {
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  "required": [
    "athlete_id",
    "date"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "coach"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}