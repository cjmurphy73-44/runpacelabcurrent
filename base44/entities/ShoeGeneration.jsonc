{
  "$id": "ShoeGeneration",
  "type": "object",
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "familyId": { "type": "string", "format": "uuid", "description": "Foreign key to ProductFamily entity" },
    "generationNumber": { "type": "integer", "description": "e.g., 9, 18" },
    "yearReleased": { "type": "integer", "description": "Year this generation was released" }
  },
  "required": ["id", "familyId", "generationNumber"]
}