{
  "name": "CoachMessage",
  "type": "object",
  "properties": {
    "athlete_id": {
      "type": "string",
      "description": "References AthleteProfile.id"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "performance_summary",
        "micro_adjustment",
        "plan_generation",
        "athlete_reply"
      ]
    },
    "content_text": {
      "type": "string",
      "description": "Message body shown in the in-app chat"
    },
    "structured_options": {
      "type": "array",
      "description": "Interactive action buttons shown with this message",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "action_type": {
            "type": "string"
          }
        }
      }
    },
    "triggered_by_workout_session_id": {
      "type": "string",
      "description": "References WorkoutSession.id that triggered this message, if any"
    }
  },
  "required": [
    "athlete_id",
    "message_type",
    "content_text"
  ]
}