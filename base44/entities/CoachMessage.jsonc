{
  "name": "CoachMessage",
  "type": "object",
  "properties": {
    "athlete_id": {
      "type": "string",
      "description": "References AthleteProfile.id"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "performance_summary",
        "micro_adjustment",
        "plan_generation",
        "athlete_reply"
      ]
    },
    "content_text": {
      "type": "string",
      "description": "Message body shown in the in-app chat"
    },
    "structured_options": {
      "type": "array",
      "description": "Interactive action buttons shown with this message",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "action_type": {
            "type": "string"
          }
        }
      }
    },
    "triggered_by_workout_session_id": {
      "type": "string",
      "description": "References WorkoutSession.id that triggered this message, if any"
    }
  },
  "required": [
    "athlete_id",
    "message_type",
    "content_text"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.athlete_id": "{{user.data.athlete_profile_id}}"
        },
        {
          "data.athlete_id": {
            "$in": "{{user.data.coached_athletes}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}