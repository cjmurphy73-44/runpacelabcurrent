{
  "name": "COROS Auto Sync",
  "description": "Refreshes COROS OAuth tokens and syncs workout + recovery data for all connected athletes every 4 hours, so data stays current without a manual sync.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "coros_auto_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_all": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "corosSync",
            "args": {
              "action": "sync_all"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sync all COROS connections",
            "description": "Refresh tokens + pull data"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 */4 * * *",
      "one_time_date": null,
      "timezone": "Australia/Brisbane",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}