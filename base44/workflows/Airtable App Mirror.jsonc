{
  "name": "Airtable App Mirror",
  "description": "Hourly batch sync of athlete data, the backend-function catalog, and feature usage/performance into the Airtable Telemetry & AI Coaching Business Tracker base.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "airtable_app_mirror",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_mirror": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "airtableSync",
            "args": {
              "action": "sync_app_mirror"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sync app mirror to Airtable",
            "description": "Athletes, workouts, plans, subscribers, roster, features, metrics"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}